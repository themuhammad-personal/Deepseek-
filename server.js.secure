import express from "express";
import path from "path";
import { fileURLToPath } from "url";

const __dirname = path.dirname(fileURLToPath(import.meta.url));
const app = express();
const PORT = process.env.PORT || 3000;

app.use(express.json({ limit: "50mb" }));
app.use(express.urlencoded({ extended: true, limit: "50mb" }));

// Security headers
app.use((req, res, next) => {
  res.setHeader('X-Content-Type-Options', 'nosniff');
  res.setHeader('X-Frame-Options', 'DENY');
  res.setHeader('X-XSS-Protection', '1; mode=block');
  res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
  next();
});

app.get("/api/health", (req, res) => {
  res.json({ status: "ok", app: "Super DeepSeek", version: "1.0.0", secure: true });
});

// ONLY serve safe directories
app.use("/static", express.static(path.join(__dirname, "static"), { maxAge: "1y", dotfiles: "deny" }));
app.use("/docs", express.static(path.join(__dirname, "docs"), { dotfiles: "deny" }));

const distPath = path.join(__dirname, "dist-android");
app.use("/dist-android", express.static(distPath, { maxAge: "1h", dotfiles: "deny" }));

// Explicit routes only, not wildcard static
app.get("/", (req, res) => {
  res.sendFile(path.join(__dirname, "index.html"));
});
app.get("/preview", (req, res) => {
  res.sendFile(path.join(__dirname, "claude-crazy-ui-prototype.html"));
});

app.listen(PORT, "0.0.0.0", () => {
  console.log(`⚡ Secure Super DeepSeek server on http://0.0.0.0:${PORT}`);
});
