{
  "name": "super-deepseek-android",
  "version": "1.0.0",
  "description": "Super DeepSeek — Standalone Android Native App with Modern ChatGPT & Claude UI, Model Context Protocol (MCP) and Agentic Tools",
  "homepage": "https://github.com/themuhammad-personal/Deepseek-",
  "repository": {
    "type": "git",
    "url": "https://github.com/themuhammad-personal/Deepseek-.git"
  },
  "bugs": {
    "url": "https://github.com/themuhammad-personal/Deepseek-/issues"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "npm run build:android",
    "build:android": "node build.js --target=android && node scripts/copy-to-android-assets.js",
    "copy-assets": "node scripts/copy-to-android-assets.js",
    "sanitize": "node scripts/sanitize-dist.js --target=android",
    "pretest": "npm run build:android",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "android:test": "cd android && ./gradlew testDebugUnitTest",
    "android:assemble:debug": "npm run build:android && cd android && ./gradlew assembleDebug",
    "android:assemble:release": "npm run build:android && cd android && ./gradlew assembleRelease",
    "test:ci": "npm run build:android && npm run test:unit"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "jsdom": "^26.1.0",
    "selenium-webdriver": "^4.46.0",
    "svelte": "^5.28.2",
    "vite": "^6.3.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "docx": "^9.6.1",
    "express": "^5.2.1",
    "fflate": "^0.8.2",
    "html2canvas": "^1.4.1",
    "ignore": "^7.0.5",
    "marked": "^18.0.3",
    "pptxgenjs": "^4.0.1",
    "turndown": "^7.2.4",
    "vega": "^6.4.0",
    "vega-embed": "^7.2.0",
    "vega-interpreter": "^2.3.2",
    "vega-lite": "^6.4.3",
    "xlsx": "^0.18.5",
    "youtube-transcript": "^1.3.0"
  }
}